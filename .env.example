PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=2h
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
FRONTEND_URL=http://localhost:5173
# Comma-separated exact browser origins allowed to call the API.
# Example: https://gradely.vercel.app,https://www.gradely.example
ALLOWED_ORIGINS=http://localhost:5173

# Email / OTP Verification (Optional)
# If omitted or left blank, OTP codes are logged to backend console for local testing.
# For live email delivery (e.g. Gmail App Password, SendGrid, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password
# SMTP_FROM="Gradely SMS <no-reply@gradely.edu>"
